<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.madzi</groupId>
        <artifactId>yaoberon</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yaoberon-cli</artifactId>
    <name>Yet Another Oberon CLI</name>
    <description>Command line tools for Oberon 07 compiler</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>io.github.madzi.yaoberon.cli.Main</exec.mainClass>
        <exec.module>io.github.madzi.yaoberon.cli</exec.module>
        <jlink.output.dir>${project.build.directory}/jlink-image</jlink.output.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-i18n</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-source</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-lexer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-format</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.madzi</groupId>
            <artifactId>yaoberon-lsp</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
          <groupId>org.jline</groupId>
          <artifactId>jline-terminal</artifactId>
        </dependency>
        <dependency>
          <groupId>org.jline</groupId>
          <artifactId>jline-terminal-ffm</artifactId>
        </dependency>
        <dependency>
          <groupId>org.eclipse.lsp4j</groupId>
          <artifactId>org.eclipse.lsp4j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${version.picocli}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                </configuration>
            </plugin>
            <plugin>
              <groupId>org.moditect</groupId>
              <artifactId>moditect-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>add-module-infos</id>
                  <phase>generate-resources</phase>
                  <goals>
                    <goal>add-module-info</goal>
                  </goals>
                  <configuration>
                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                    <jdepsExtraArgs>
                      <arg>--multi-release=25</arg>
                    </jdepsExtraArgs>
                    <modules>
                      <module>
                        <artifact>
                          <groupId>org.eclipse.lsp4j</groupId>
                          <artifactId>org.eclipse.lsp4j</artifactId>
                          <version>${version.eclipse-lsp4j}</version>
                        </artifact>
                        <moduleInfo>
                          <name>org.eclipse.lsp4j</name>
                          <open>true</open>
                        </moduleInfo>
                      </module>
                      <module>
                        <artifact>
                          <groupId>org.eclipse.lsp4j</groupId>
                          <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
                          <version>${version.eclipse-lsp4j}</version>
                        </artifact>
                        <moduleInfo>
                          <name>org.eclipse.lsp4j.jsonrpc</name>
                          <open>true</open>
                        </moduleInfo>
                      </module>
                    </modules>
                  </configuration>
                </execution>
              </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jlink-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <classifier>jlink</classifier>
                    <launcher>app=${exec.module}/${exec.mainClass}</launcher>
                    <stripDebug>true</stripDebug>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>
                    <modulePaths>
                      <modulePath>${project.build.directory}/modules</modulePath>
                    </modulePaths>
                    <ignoreSigningInformation>true</ignoreSigningInformation>
                </configuration>
                <executions>
                    <execution>
                        <id>default-jlink</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <configuration>
                    <name>yao</name>
                    <appVersion>1.0.0</appVersion>
                    <vendor>Madzi</vendor>
                    <destination>${project.build.directory}/dist</destination>
                    <runtimeImage>${project.build.directory}/maven-jlink/classifiers/jlink</runtimeImage>
                    <module>${exec.module}/${exec.mainClass}</module>
                    <type>APP_IMAGE</type>
                </configuration>
                <executions>
                    <execution>
                        <id>jpackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
